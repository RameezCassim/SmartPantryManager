<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pantry_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Green Settings header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_header">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMART PANTRY"
                android:textSize="12sp"
                android:textColor="@color/pantry_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Settings"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Personalize your pantry experience"
                android:textSize="14sp"
                android:textColor="@color/pantry_white" />
        </LinearLayout>

        <!-- Preferences heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Pantry Preferences"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_text" />

        <!-- Settings card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card">

            <Switch
                android:id="@+id/switchExpiryWarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiry Warnings"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_text"
                android:checked="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Highlight pantry ingredients that are expired or approaching their expiry date."
                android:textSize="13sp"
                android:textColor="@color/pantry_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:background="#E0E9E3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Warn Me Before Expiry"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Choose how early ingredients should be highlighted."
                android:textSize="13sp"
                android:textColor="@color/pantry_muted" />

            <Spinner
                android:id="@+id/spinnerExpiryDays"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:id="@+id/tvSettingsSaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Changes are saved automatically."
                android:textSize="12sp"
                android:textColor="@color/pantry_green_dark" />

        </LinearLayout>

        <!-- About section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="About Smart Pantry"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pantry Manager"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Track ingredients, reduce food waste, and discover recipes you can make using the food already in your pantry."
                android:textSize="14sp"
                android:textColor="@color/pantry_muted" />

        </LinearLayout>

        <!-- Navigation -->
        <Button
            android:id="@+id/btnSettingsBackToPantry"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:text="Back to My Pantry"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>
