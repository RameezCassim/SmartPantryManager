<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recipeDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pantry_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Recipe header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_header">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMART PANTRY"
                android:textSize="12sp"
                android:textColor="@color/pantry_white" />

            <TextView
                android:id="@+id/tvDetailRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Recipe Name"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="@color/pantry_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Recipe Details"
                android:textSize="14sp"
                android:textColor="@color/pantry_white" />
        </LinearLayout>

        <!-- Availability section -->
        <TextView
            android:id="@+id/tvDetailAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="15dp"
            android:text="Checking ingredients..."
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_card"
            android:textColor="@color/pantry_green_dark" />

        <!-- Ingredient heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Required Ingredients"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_text" />

        <!-- Dynamic ingredient list -->
        <LinearLayout
            android:id="@+id/recipeIngredientsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/bg_card" />

        <!-- Preparation heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Preparation Method"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/pantry_text" />

        <!-- Preparation content -->
        <TextView
            android:id="@+id/tvPreparationSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="18dp"
            android:text="Preparation instructions"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/pantry_text"
            android:background="@drawable/bg_card" />

        <!-- Back button -->
        <Button
            android:id="@+id/btnBackFromRecipeDetails"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="Back to Recipes"
            android:textColor="@android:color/white"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
