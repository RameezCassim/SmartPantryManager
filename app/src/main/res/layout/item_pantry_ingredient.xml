<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ingredientCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <!-- INGREDIENT DETAILS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- INGREDIENT NAME -->
        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient"
            android:textColor="@color/pantry_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- QUANTITY -->
        <TextView
            android:id="@+id/tvItemQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 pieces"
            android:textColor="@color/pantry_green_dark"
            android:textSize="15sp" />

        <!-- EXPIRY DATE -->
        <TextView
            android:id="@+id/tvItemExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No expiry date"
            android:textColor="@color/pantry_muted"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- EDIT ARROW -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="›"
        android:textColor="@color/pantry_green_dark"
        android:textSize="30sp"
        android:contentDescription="Tap to edit ingredient" />

</LinearLayout>
