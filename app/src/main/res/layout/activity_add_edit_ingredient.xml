<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pantry_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- FORM TITLE -->
        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_ingredient_title"
            android:textColor="@color/pantry_green_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ingredient_form_subtitle"
            android:textStyle="bold"
            android:textColor="@color/pantry_muted"
            android:textSize="14sp" />

        <!-- INGREDIENT NAME LABEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ingredient_name_label"
            android:textColor="@color/pantry_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- INGREDIENT NAME INPUT -->
        <EditText
            android:id="@+id/etIngredientName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:hint="@string/ingredient_name_hint"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_muted"
            android:textSize="16sp" />

        <!-- QUANTITY LABEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/quantity_label"
            android:textColor="@color/pantry_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- QUANTITY INPUT -->
        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:hint="@string/quantity_hint"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:textColor="@color/pantry_text"
            android:textColorHint="@color/pantry_muted"
            android:textSize="16sp" />

        <!-- MEASUREMENT UNIT LABEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/unit_label"
            android:textColor="@color/pantry_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- MEASUREMENT UNIT DROPDOWN -->
        <Spinner
            android:id="@+id/spinnerUnit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_card"
            android:entries="@array/ingredient_units" />

        <!-- EXPIRY DATE LABEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/expiry_label"
            android:textColor="@color/pantry_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- SELECTED EXPIRY DATE -->
        <TextView
            android:id="@+id/tvExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="14dp"
            android:background="@drawable/bg_card"
            android:text="@string/select_expiry"
            android:textColor="@color/pantry_muted"
            android:textSize="16sp" />

        <!-- SELECT EXPIRY DATE BUTTON -->
        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_outline_button"
            android:backgroundTint="@null"
            android:text="@string/select_expiry"
            android:textAllCaps="false"
            android:textColor="@color/pantry_white" />

        <!-- CLEAR EXPIRY DATE BUTTON -->
        <Button
            android:id="@+id/btnClearDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="@string/clear_expiry"
            android:textAllCaps="false" />

        <!-- SAVE INGREDIENT BUTTON -->
        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="@string/save_ingredient"
            android:textAllCaps="false"
            android:textColor="@color/pantry_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- CANCEL BUTTON -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/cancel"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
